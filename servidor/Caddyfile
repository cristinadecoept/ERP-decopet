# Caddy pone el candado (HTTPS) solo, gratis y renovándolo solo.
# Se copia a /etc/caddy/Caddyfile
erp.shopdecopet.com {
    encode gzip
    reverse_proxy 127.0.0.1:8765

    # el ERP no es una web pública: que no salga en Google
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }
    request_body {
        max_size 25MB
    }
}
